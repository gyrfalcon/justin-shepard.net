  "license": "MIT",
  "source": "src/index.html",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "build": "parcel build",
    "ci:lint": "eslint --format junit --output-file reports/eslint/eslint.xml",
    "lint": "eslint",
    "start": "parcel",
    "test:acceptance": "playwright test",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "buffer": "6.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.4.2",
    "jest-junit": "17.0.0",
    "parcel": "2.16.4",
    "prettier": "3.8.3",
    "process": "0.11.10",
    "serve-static": "2.2.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "axios": "1.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
